{
  "name": "ShopAI",
  "version": "1.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs",
    "start": "expo start",
    "postinstall": "patch-package",
    "eas:update:configure": "npx eas-cli update:configure",
    "release:configure": "node scripts/configure-release.cjs",
    "release:keystore": "node scripts/create-keystore.cjs",
    "android:release": "node scripts/build-android-release.cjs",
    "android:firebase:debug": "node scripts/build-android-release.cjs --debug",
    "update:rollback": "npx eas-cli update:rollback",
    "eas:build:preview": "npm run release:configure -- staging && npx eas-cli build --platform android --profile preview",
    "eas:build:production": "npm run release:configure -- production && npx eas-cli build --platform android --profile production",
    "update:staging": "node scripts/eas-update.cjs staging",
    "update:development": "node scripts/eas-update.cjs development",
    "update:production": "node scripts/eas-update.cjs production",
    "test": "jest",
    "verify:live": "node scripts/verify-live.cjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/run-e2e.cjs",
    "android:usb": "node scripts/build-android-usb.cjs",
    "phone:connect": "node scripts/connect-android.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.18.10",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.19.0",
    "expo": "^57.0.29",
    "expo-dev-client": "~57.0.20",
    "expo-local-authentication": "~57.0.3",
    "expo-modules-core": "^57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-updates": "^57.0.26",
    "i18next": "^26.3.6",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-preset-expo": "^57.0.15",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
