# Teaching outline only. CI does not execute store submission.
default_platform(:ios)
platform :ios do
  desc 'Example: archive and submit to TestFlight using your own Apple credentials'
  lane :beta do
    unless ENV['SHOPAI_ALLOW_STORE_SUBMIT'] == 'true'
      UI.user_error!('Example disabled. Configure Apple signing/API credentials and explicitly opt in before store submission.')
    end
    increment_build_number(xcodeproj: 'ios/ShopAI.xcodeproj')
    build_app(project: 'ios/ShopAI.xcodeproj', scheme: 'ShopAI')
    upload_to_testflight(api_key_path: ENV.fetch('APP_STORE_CONNECT_API_KEY_PATH'))
  end
end
